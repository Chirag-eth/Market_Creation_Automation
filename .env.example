# Server
PORT=2020

# CSV source of truth (set both for explicit override)
# LEAGUES_CSV_PATH=/absolute/path/to/leagues.csv
# TEAMS_CSV_PATH=/absolute/path/to/teams.csv

# Optional: enable fallback check in ~/Downloads for local testing only
ALLOW_DOWNLOADS_CSV_FALLBACK=0

# Optional API auth for /api/*
# API_BEARER_TOKEN=replace_with_random_secret

# Optional basic auth for dashboard/static pages
# APP_BASIC_AUTH_USER=admin
# APP_BASIC_AUTH_PASS=replace_with_strong_password

# API rate limiting
API_RATE_MAX_REQUESTS=180
API_RATE_WINDOW_MS=60000

# Trust X-Forwarded-For only when running behind a known reverse proxy/load balancer
TRUST_PROXY=0
