{
  "name": "fixture-ocr-market-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:mainnet": "APP_ENV=mainnet node server.js",
    "start:uat": "APP_ENV=uat node server.js",
    "start:dev": "APP_ENV=dev node server.js",
    "dev": "node scripts/start.mjs",
    "dev:mainnet": "APP_ENV=mainnet node server.js",
    "dev:uat": "APP_ENV=uat node server.js",
    "dev:dev": "APP_ENV=dev node server.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "probe:schedules": "node scripts/probe_schedules.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.js src/app/*.js src/backend/*.js src/backend/*/*.js src/composer/*.js src/core/*.js src/data/*.js src/shared/*.js tests/*.mjs tests/helpers/*.mjs scripts/*.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.58.2",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  }
}
