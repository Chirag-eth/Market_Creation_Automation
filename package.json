{
  "name": "fixture-ocr-market-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:mainnet": "APP_ENV=mainnet node server.js",
    "start:uat": "APP_ENV=uat node server.js",
    "start:dev": "APP_ENV=dev node server.js",
    "dev": "node scripts/start.mjs",
    "dev:mainnet": "APP_ENV=mainnet node server.js",
    "dev:uat": "APP_ENV=uat node server.js",
    "dev:dev": "APP_ENV=dev node server.js",
    "dev:dev:local": "PUBLIC_BASE_URL= APP_ENV=dev node server.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "probe:schedules": "node scripts/probe_schedules.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:core": "node --test tests/batchResolutionService.test.mjs tests/oauthFlow.test.mjs tests/openapiDocs.test.mjs",
    "check": "node --check server.js src/app/*.js src/backend/*.js src/backend/*/*.js src/composer/*.js src/core/*.js src/data/*.js src/shared/*.js tests/*.mjs tests/helpers/*.mjs scripts/*.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{server.js,README.md,eslint.config.js}\" \"src/server/**/*.js\" \"docs/**/*.{md,json,yaml,yml}\" \".github/**/*.{md,yml}\" \"tests/{batchResolutionService,oauthFlow,openapiDocs}.test.mjs\"",
    "format:check": "prettier --check \"{server.js,README.md,eslint.config.js}\" \"src/server/**/*.js\" \"docs/**/*.{md,json,yaml,yml}\" \".github/**/*.{md,yml}\" \"tests/{batchResolutionService,oauthFlow,openapiDocs}.test.mjs\"",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "playwright": "^1.58.2",
    "prettier": "^3.8.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
