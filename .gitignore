# Throwaway operator scripts (one-off DB ops, probes, mainnet dumps).
# Pattern intentionally matches both `scripts/` (canonical home) and the
# repo root, where ad-hoc probes sometimes land before being moved or
# deleted. A bare `git add .` would otherwise stage them.
scripts/tmp_*.mjs
tmp_*.mjs
tmp_*.json

# iCloud / Finder duplicate pattern: "name 2.ext"
**/* 2.*
**/* 2

# Legacy: personal portfolio export accidentally landed here once
portfolio_export/
